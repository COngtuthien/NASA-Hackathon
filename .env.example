# SpaceFire AI configuration. Copy to `.env` (never commit `.env`).
# Every variable is optional: without an LLM key the app runs in retrieval-only mode.

# --- AI synthesis (provider-agnostic; implemented: gemini, anthropic) ---
# Gemini (Google AI Studio key; the free tier works, billing is not required):
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# LLM_BASE_URL=
LLM_TIMEOUT_S=60
# Gemini reasoning depth: minimal | low | medium | high (low = faster, fewer free-tier tokens)
LLM_THINKING_LEVEL=low
# Reuse the model's verified output for an identical question + evidence (saves free-tier quota); 0 disables
LLM_CACHE_TTL_HOURS=168
# Anthropic instead: LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5-5

# --- Data ---
# Defaults to processed/spacefire.db (generated by scripts/ingest)
# DATABASE_PATH=

# --- External literature (NASA NTRS, OpenAlex, Crossref) ---
EXTERNAL_SEARCH_ENABLED=true
EXTERNAL_CACHE_TTL_HOURS=24
EXTERNAL_TIMEOUT_S=15
# Optional: OpenAlex polite-pool contact and personal API key (higher daily budget)
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# --- Retrieval (dense component fused with BM25: lsa | neural | both; neural needs requirements-neural.txt) ---
RETRIEVAL_DENSE=lsa

# --- Web ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Frontend proxy target (read by frontend/next.config.ts)
BACKEND_URL=http://127.0.0.1:8000
