  "findings": [
   {
    "id": "fd-critical-temperature",
    "text": "All ISS flames observed by the project extinguish at a critical extinction temperature of 1130 K, at a fuel mass flux of 0.2 g/m2-s for normal flames and an oxygen mass flux of 0.68 g/m2-s for inverse flames.",
    "page_pdf": 26,
    "kind": "report_statement",
    "values": [
     {
      "variable": "critical extinction temperature",
      "value": 1130,
      "unit": "K"
     },
     {
      "variable": "critical fuel mass flux (normal)",
      "value": 0.2,
      "unit": "g/m2-s"
     },
     {
      "variable": "critical oxygen mass flux (inverse)",
      "value": 0.68,
      "unit": "g/m2-s"
     }
    ]
   },
   {
    "id": "fd-growth",
    "text": "Microgravity spherical diffusion flames grow monotonically after ignition; radiative extinction occurs when, at constant reactant flow rate, the flame expands until radiation heat loss approaches the chemical heat release; an oscillatory mode can precede extinction.",
    "page_pdf": 26,
    "kind": "report_statement"
   },
   {
    "id": "fd-burn-times",
    "text": "Burn times in the 2021 long-duration study ranged from 28 to 336 s.",
    "page_pdf": 26,
    "kind": "report_statement",
    "values": [
     {
      "variable": "burn time range (2021 study)",
      "value": [
       28,
       336
      ],
      "unit": "s"
     }
    ]
   },
   {
    "id": "fd-steady-time",
    "text": "In the spherical, infinite-domain configuration the characteristic time to reach steady state is on the order of 10^5 s.",
    "page_pdf": 27,
    "kind": "report_statement"
   },
   {
    "id": "fd-limits",
    "text": "For safety, O2 was limited to 40% for normal tests and C2H4 to 65% for inverse flames; CH4 and CO2-diluent tests were slated but not allowed.",
    "page_pdf": 27,
    "kind": "report_statement"
   },
   {
    "id": "fd-shortcomings",
    "text": "TFP fibre array misaligned for four test days; round-1 radiometers saturated for nearly every test; burner asymmetry; MFC flows not always steady.",
    "page_pdf": 19,
    "kind": "report_statement"
   }
  ]
 },
