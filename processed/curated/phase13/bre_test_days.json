 "notes": [
  "Chamber pressures were varied but are not identified in Table 1 or the CSV.",
  "19091 (1 April 2019): no flames; the hot-wire igniter tip had failed (data interpretation p5)."
 ],
 "extra": {
  "totals": {
   "table1_flames": 194,
   "round1": 62,
   "round2": 132,
   "csv_flames": 194,
   "csv_rows": 18,
   "report_statement": "62 and 132 flames in rounds 1 and 2, 194 in total (BRE_data_interpretation_20220804.pdf p4)"
  },
  "findings": [
   {
    "id": "bre-quasi-steady",
    "text": "Quasi-steady flames on the flat 25-mm burner were observed for nominal ambient oxygen mole fractions of 0.265 and above; pressure had a weak effect on burning quality.",
    "page_pdf": 39,
    "kind": "report_statement"
   },
   {
    "id": "bre-21pct",
    "text": "All flames ignited in a normal atmosphere (21% O2, 14.7 psia) self-extinguished within 40 s; at 27% O2/10.2 psia and 34% O2/8.2 psia flames generally persisted for 3 minutes or more.",
    "page_pdf": 18,
    "kind": "report_statement"
   },
   {
    "id": "bre-pmma",
    "text": "Test 19070D1 (34% O2, 8.2 psia, hc 24 kJ/g, L = 2.42 kJ/g) reached a steady state; the authors note this emulation could represent PMMA (an emulation analogy, not a PMMA test).",
    "page_pdf": 26,
    "kind": "report_statement"
   },
   {
    "id": "bre-limits",
    "text": "Large flames extinguished due to radiative heat loss, while small flames quenched at a second limit.",
    "page_pdf": 40,
    "kind": "report_statement"
   },
   {
    "id": "bre-methane",
    "text": "Methane was hard to ignite compared with ethylene and its flames tended to self-extinguish faster even at high oxygen concentration.",
    "page_pdf": 33,
    "kind": "report_statement"
   },
   {
    "id": "bre-not-done",
    "text": "O2/CO2 atmospheres (objective 2) were not investigated.",
    "page_pdf": 40,
    "kind": "report_statement"
   }
  ]
 },
